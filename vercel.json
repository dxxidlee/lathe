{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/brand/capture.js": {
      "maxDuration": 60
    },
    "api/brand/timeline.js": {
      "maxDuration": 60
    },
    "api/brand/shot.js": {
      "maxDuration": 60
    },
    "api/brand/observe.js": {
      "maxDuration": 120
    },
    "api/brand/social.js": {
      "maxDuration": 30
    },
    "api/ig/[username].js": {
      "maxDuration": 30,
      "includeFiles": "public/data/mock-posts.json"
    },
    "api/ig-media.js": {
      "maxDuration": 30
    },
    "api/make.js": {
      "maxDuration": 60
    },
    "api/expand.js": {
      "maxDuration": 15
    }
  }
}
