# Lathe API keys: template. Copy to .env.local and fill in there.
# The app works with every value empty: each key only unlocks its source.
# Server-side only (read by /api functions). Do not prefix with VITE_.

# Audit: subject sources
ARENA_TOKEN=
# COOPER_HEWITT_KEY and RIJKS_KEY are no longer read: both museums replaced their keyed APIs with
# keyless ones. They stay listed so older .env.local files still match.
COOPER_HEWITT_KEY=
SMITHSONIAN_KEY=
HARVARD_KEY=
EUROPEANA_KEY=
RIJKS_KEY=
UNSPLASH_KEY=

# Audit: brand mode. Screenshots work without MICROLINK_KEY on Microlink's free tier (a small daily
# quota); BRANDFETCH_KEY adds official logos, colors and fonts; ANTHROPIC_API_KEY adds generated observations.
MICROLINK_KEY=
BRANDFETCH_KEY=
ANTHROPIC_API_KEY=
# Instagram Graph API (Business Discovery): INSTAGRAM_ACCESS_TOKEN is a never-expiring Page token
# (instagram_basic, pages_show_list); INSTAGRAM_USER_ID is your own business/creator account's id.
# Without the token, brand audits show sample posts from public/data/mock-posts.json.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Identifies Lathe to archive APIs in its User-Agent (Wikimedia rate-limits anonymous agents).
# Optional; defaults to https://github.com/dxxidlee. Set it to the deployed site URL.
LATHE_CONTACT_URL=

# Supabase: auth and cloud storage. VITE_ vars are client-side (public).
# SERVICE_ROLE_KEY is server-only; used by /api/make for JWT verification and rate limiting.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
