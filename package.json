{
  "name": "lathe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tools for people who make tools. Thesis project by David Lee.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4318 --strictPort",
    "typecheck": "tsc -b",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify:shell": "npm run build && node verify/shell.mjs",
    "verify:port": "npm run build && node verify/port.mjs",
    "verify:defaults": "npm run build && node verify/defaults.mjs",
    "verify:audit": "npm run build && node verify/audit.mjs",
    "verify:brand": "npm run build && node verify/brand.mjs",
    "verify:image": "npm run build && node verify/image.mjs",
    "verify:m8": "npm run build && node verify/m8.mjs",
    "verify:make": "npm run build && node verify/make.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@imgly/background-removal": "^1.7.0",
    "esm-potrace-wasm": "^0.5.1",
    "fix-webm-duration": "^1.0.6",
    "gif.js": "^0.2.0",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "node-html-parser": "^9.0.4",
    "opentype.js": "^2.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "woff2-encoder": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
